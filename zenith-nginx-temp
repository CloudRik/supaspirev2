server {
    listen 80;
    server_name _;
    location / {
        return 200 'ZenithOS Deployment Server';
        add_header Content-Type text/plain;
    }
}

server {
    listen 80;
    server_name cervizo-live.cloudrik.com www.cervizo-live.cloudrik.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name cervizo-live.cloudrik.com www.cervizo-live.cloudrik.com;
    ssl_certificate /etc/letsencrypt/live/cervizo-live.cloudrik.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cervizo-live.cloudrik.com/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}

